{
  "name": "bluestem-pricing-margin-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev:rimex": "vite --mode rimex",
    "build:rimex": "tsc && vite build --mode rimex",
    "preview:rimex": "vite preview --mode rimex",
    "dev:sunset": "vite --mode sunset",
    "build:sunset": "tsc && vite build --mode sunset",
    "preview:sunset": "vite preview --mode sunset",
    "build:all": "npm run build && npm run build:rimex && npm run build:sunset"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
